{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@selah/domain": ["../packages/domain/src/index.ts"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "*.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
