{
  "expo": {
    "name": "SELAH",
    "slug": "selah",
    "scheme": "selah",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zionnaireconcepts.selah"
    },
    "android": {
