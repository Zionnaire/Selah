NODE_ENV=development
PORT=4000

# The exact origin of the web app, no trailing slash. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# Both spellings are accepted for the database URI and the Groq key.
Mongodb_URI=mongodb+srv://user:password@cluster/selah
Groq_API_KEY=

# 48 random bytes each, hex. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# lax when the app and API share a domain (recommended). none only across different sites.
COOKIE_SAME_SITE=lax

# Email (password reset, verification). Planned, not read by the API yet.
EMAIL_API_KEY=
EMAIL_FROM=SELAH <no-reply@mail.example.org>

# SELAH suggestions in Sermon Studio. Both optional. Defaults: openai/gpt-oss-120b and 25 a day per account. Check GET https://api.groq.com/openai/v1/models for what your account can use.
GROQ_MODEL=
AI_DAILY_LIMIT=
