{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./Backend/.env)",
      "Read(./Frontend/.env)",
      "Read(./.env)",
      "Edit(./Backend/.env)",
      "Edit(./Frontend/.env)",
      "Bash(git push *)",
      "Bash(taskkill *)"
    ]
  }
}
